rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hotspots/{hotspotId} {
      // Everyone can read only approved public listings.
      allow get, list: if resource.data.status == "approved";
      // Anyone can submit a pending listing. Public clients cannot approve,
      // edit, or delete listings. Review and approval happen in Firebase Console.
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "name", "area", "access", "hours", "notes", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && request.resource.data.area.size() <= 60
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 180;
      allow update, delete: if false;
    }
  }
}